{
  "title": "Code runs",
  "uid": "code-runs-metrics",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Code passes",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum(increase(code_executions_total{outcome=\"success\"}[$__rate_interval]))",
          "legendFormat": "Code passes"
        }
      ]
    },
    {
      "id": 2,
      "title": "Code failures",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum(increase(code_executions_total{outcome!=\"success\"}[$__rate_interval]))",
          "legendFormat": "Code failures"
        }
      ]
    },
    {
      "id": 3,
      "title": "Code runs",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum(increase(code_executions_total[$__rate_interval]))",
          "legendFormat": "Code runs"
        }
      ]
    }
  ]
}
