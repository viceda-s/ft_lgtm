{
  "title": "Dashboard 2: Traces - The Detective's Tool",
  "uid": "dashboard-traces",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title":"/api/execute duration over time",
      "description": "Trace duration over time (spot the outliers!)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "blue" }
        }
      },
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceql",
          "query": "{ trace:rootName = \"/api/execute\" } | avg_over_time(span:duration)"
        }
      ]
    },
    {
      "id": 2,
      "title":"Slowest /api/execute calls",
      "description": "Slowest executions (what's taking so long?)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "red" }
        }
      },
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceql",
          "query": "{ trace:rootName = \"/api/execute\" } | max_over_time(span:duration)"
        }
      ]
    },
    {
      "id": 3,
      "title":"Mean duration",
      "description": "Mean execution duration (the baseline)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "green" }
        }
      },
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceql",
          "query": "{ trace:rootName = \"/api/execute\" } | avg_over_time(span:duration)"
        }
      ]
    },
    {
      "id": 4,
      "title":"Longest duration",
      "description": "Longest execution duration (the record holder)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "red" }
        }
      },
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceql",
          "query": "{ trace:rootName = \"/api/execute\" } | max_over_time(span:duration)"
        }
      ]
    }
  ]
}