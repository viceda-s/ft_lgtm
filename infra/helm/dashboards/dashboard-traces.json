{
  "title": "/api/execute duration",
  "uid": "api-execute-duration",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title":"/api/execute duration over time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceql", 
          "query": "{ trace:rootName = \"/api/execute\" } | avg_over_time(span:duration)"
        }
      ]
    },
    {
      "id": 2,
      "title":"Slowest /api/execute calls",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
