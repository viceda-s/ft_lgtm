      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceql", 
          "query": "{ trace:rootName = \"/api/execute\" } | max_over_time(span:duration)"
        }
      ]
    },
    {
      "id": 3,
