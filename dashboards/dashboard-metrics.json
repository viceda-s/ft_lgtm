{
  "title": "Dashboard 1: Metrics - The Big Picture",
  "uid": "dashboard-metrics",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Code passes",
      "description": "Number of successful executions (the green line going up!)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "custom": {
            "fillOpacity": 80,
            "gradientMode": "opacity"
          },
          "decimals": 0
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum(increase(code_executions_total{outcome=\"success\"}[5m]))",
          "legendFormat": "Code passes"
        }
      ]
    },
    {
      "id": 2,
      "title": "Code failures",
      "description": "Number of failed executions (debugging opportunities)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          },
          "custom": {
            "fillOpacity": 80,
            "gradientMode": "opacity"
          },
          "decimals": 0
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum(increase(code_executions_total{outcome!=\"success\"}[5m]))",
          "legendFormat": "Code failures"
        }
      ]
    },
    {
      "id": 3,
      "title": "Code runs",
      "description": "Total executions (your platform's heartbeat)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          },
          "custom": {
            "fillOpacity": 80,
            "gradientMode": "opacity"
          },
          "decimals": 0
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum(increase(code_executions_total[5m]))",
          "legendFormat": "Code runs"
        }
      ]
    },
    {
      "id": 4,
      "title": "Runs by language",
      "description": "Executions per language over the last 5 minutes (most popular languages)",
      "type": "timeseries",
      "gridPos": {
        "h": 16,
        "w": 8,
        "x": 16,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 40,
            "gradientMode": "opacity"
          },
          "decimals": 0
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum by (language) (increase(code_executions_total{language!=\"\"}[5m]))",
          "legendFormat": "{{language}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Successful executions",
      "description": "Successful executions in the selected time range",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "decimals": 0
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "round(sum(increase(code_executions_total{outcome=\"success\"}[$__range])))",
          "instant": true,
          "range": false,
          "legendFormat": "Successful executions"
        }
      ]
    },
    {
      "id": 6,
      "title": "Failed executions",
      "description": "Failed executions in the selected time range",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          },
          "decimals": 0
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "round(sum(increase(code_executions_total{outcome!=\"success\"}[$__range])))",
          "instant": true,
          "range": false,
          "legendFormat": "Failed executions"
        }
      ]
    },
    {
      "id": 7,
      "title": "Total executions",
      "description": "All executions in the selected time range",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          },
          "decimals": 0
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "round(sum(increase(code_executions_total[$__range])))",
          "instant": true,
          "range": false,
          "legendFormat": "Total executions"
        }
      ]
    }
  ]
}
