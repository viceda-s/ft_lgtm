{
  "title": "Dashboard 2: Traces - The Detective's Tool",
  "uid": "dashboard-traces",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "/api/execute duration over time",
      "description": "Trace duration over time (spot the outliers!)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "custom": {
            "fillOpacity": 80,
            "gradientMode": "opacity"
          },
          "unit": "s"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ name = \"/api/execute\" } | avg_over_time(duration)"
        }
      ]
    },
    {
      "id": 2,
      "title": "Slowest executions",
      "description": "Slowest executions (what's taking so long?)",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "traceDuration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "displayName",
                "value": "Duration"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "traceService"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "traceName"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "tableType": "traces",
          "limit": 1000,
          "query": "{ name = \"/api/execute\" } | select(span.execution.outcome, span.code.cid, span.code.hash)"
        }
      ],
      "options": {
        "sortBy": [
          {
            "displayName": "Duration",
            "desc": true
          }
        ]
      }
    },
    {
      "id": 3,
      "title": "Mean duration",
      "description": "Mean execution duration (the baseline)",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "unit": "s"
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "mean"
          ]
        },
        "graphMode": "area"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "metricsQueryType": "instant",
          "query": "{ name = \"/api/execute\" } | avg_over_time(duration)"
        }
      ]
    },
    {
      "id": 4,
      "title": "Longest duration",
      "description": "Longest execution duration (the record holder)",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          },
          "unit": "s"
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "max"
          ]
        },
        "graphMode": "area"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ name = \"/api/execute\" } | max_over_time(duration)"
        }
      ]
    },
    {
      "id": 5,
      "title": "IPFS network propagation (DHT provide)",
      "description": "How long announcing each new CID to the IPFS DHT takes. Every point is an ipfs_provide trace linked to its execution; click one to open it.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "custom": {
            "fillOpacity": 80,
            "gradientMode": "opacity"
          },
          "unit": "s"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "avg_over_time"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "mean"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "max_over_time"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "max"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ name = \"ipfs_provide\" } | avg_over_time(duration)",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ name = \"ipfs_provide\" } | max_over_time(duration)",
          "refId": "B"
        }
      ]
    }
  ]
}
