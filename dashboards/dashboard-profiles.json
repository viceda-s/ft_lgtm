{
  "title": "Dashboard 4: Profiles - CPU, Memory and Hot Paths",
  "uid": "dashboard-profiles",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "title": "WASM CPU time per run",
      "description": "CPU time of the thread running the user's WebAssembly (execute span). Click a point to open that run's trace.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "custom": {
            "fillOpacity": 20,
            "gradientMode": "opacity",
            "showPoints": "always",
            "pointSize": 6
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "avg_over_time"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "mean"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "max_over_time"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "max"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "query": "{ name = \"execute\" } | avg_over_time(span.execution.cpu_time_ms)"
        },
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "B",
          "queryType": "traceql",
          "query": "{ name = \"execute\" } | max_over_time(span.execution.cpu_time_ms)"
        }
      ],
      "id": 1
    },
    {
      "title": "WASM instructions per run",
      "description": "Wasmtime fuel consumed by the user's program, roughly one unit per WebAssembly instruction",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "fillOpacity": 20,
            "gradientMode": "opacity",
            "showPoints": "always",
            "pointSize": 6
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "avg_over_time"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "mean"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "max_over_time"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "max"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "query": "{ name = \"execute\" } | avg_over_time(span.wasm.fuel_consumed)"
        },
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "B",
          "queryType": "traceql",
          "query": "{ name = \"execute\" } | max_over_time(span.wasm.fuel_consumed)"
        }
      ],
      "id": 2
    },
    {
      "title": "WASM memory per run",
      "description": "Size of the program's linear memory when it finished, which is its peak since WebAssembly memory only grows",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "fillOpacity": 20,
            "gradientMode": "opacity",
            "showPoints": "always",
