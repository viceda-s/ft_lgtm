    {
      "title": "Backend CPU hot paths",
      "description": "Where the backend spends CPU, from continuous Pyroscope profiling. Time inside the user's WebAssembly shows up under executor.(*Executor).Run.",
      "type": "flamegraph",
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "grafana-pyroscope-datasource",
        "uid": "pyroscope"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-pyroscope-datasource",
            "uid": "pyroscope"
          },
          "refId": "A",
          "queryType": "profile",
          "profileTypeId": "process_cpu:cpu:nanoseconds:cpu:nanoseconds",
          "labelSelector": "{service_name=\"ft_lgtm-backend\"}",
          "groupBy": []
        }
      ],
      "id": 6
    },
    {
      "title": "Backend memory allocations",
      "description": "Bytes allocated by the backend, by call path, from Pyroscope allocation profiles",
      "type": "flamegraph",
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "datasource": {
        "type": "grafana-pyroscope-datasource",
        "uid": "pyroscope"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-pyroscope-datasource",
